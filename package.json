{
  "name": "gunslinger",
  "productName": "Gunslinger",
  "version": "1.0.0",
  "description": "Terminal desktop personalizável para Windows, com foco em .NET e Node.js",
  "main": "out/main/index.js",
  "author": "Felipe Santana",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "postinstall": "electron-rebuild -f -o @vscode/windows-process-tree",
    "dist": "npm run build && electron-builder --win --publish never",
    "site:capture": "electron-vite build && playwright test -c site/capture/playwright.config.ts"
  },
  "dependencies": {
    "@vscode/windows-process-tree": "0.6.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/addon-unicode11": "0.8.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0",
    "electron-updater": "6.3.9",
    "fuzzysort": "3.1.0",
    "jsonc-parser": "3.3.1",
    "node-pty": "1.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8",
    "zustand": "5.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "3.7.1",
    "@eslint/js": "9.15.0",
    "@playwright/test": "1.48.2",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.2.0",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.12.0",
    "prettier": "3.3.3",
    "rcedit": "^4.0.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
