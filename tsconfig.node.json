{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": [
      "ES2022"
    ],
    "types": [
      "node",
      "electron-vite/node",
      "vitest/globals"
    ]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.mts",
    "playwright.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*"
  ]
}
